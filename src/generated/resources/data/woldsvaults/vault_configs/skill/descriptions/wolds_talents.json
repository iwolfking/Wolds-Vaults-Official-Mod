  "descriptions": {
    "Healthy_Elixir": [
      {
        "text": "Enhances the ",
        "color": "$text"
      },
      {
        "text": "Healthiness ",
        "color": "#E9C375"
      },
      {
        "text": "of your ",
        "color": "$text"
      },
      {
        "text": "Vault Potion ",
        "color": "aqua"
      },
      {
        "text": ", making it also heal an additional percentage of your ",
        "color": "$text"
      },
      {
        "text": "max health",
        "color": "green"
      },
      {
        "text": ".\n\nDepending on the tier, the amount restored will be modified: ",
        "color": "$text"
      },
      {
        "text": "\n<yellow>Vial<white>: <red>50% reduction",
        "color": "$text"
      },
      {
        "text": "\n<yellow>Potion<white>: <red>25% reduction",
        "color": "$text"
      },
      {
        "text": "\n<yellow>Mixture<white>: <gold>0% reduction",
        "color": "$text"
      },
      {
        "text": "\n<yellow>Brew<white>: <green>50% increase",
        "color": "$text"
      },
      {
        "text": ".\n\n1 ",
        "color": "$text"
      },
      {
        "text": "+20%",
        "color": "#E9C375"
      },
      {
        "text": "\n\n2 ",
        "color": "$text"
      },
      {
        "text": "+30%",
        "color": "#E9C375"
      },
      {
        "text": "\n\n3 ",
        "color": "$text"
      },
      {
        "text": "+40%",
        "color": "#E9C375"
      },
      {
        "text": "\n\n",
        "color": "$text"
      },
      {
        "text": "Overlevels to <gold>Healthy Elixir<white> add <green>3% additional max health restored",
        "color": "$text"
      }
    ],
    "Momentum_Engine": [
      {
        "text": "While moving, builds up stacks of ",
        "color": "$text"
      },
      {
        "text": "Momentum ",
        "color": "#E9C375"
