{
  "descriptions": {
    "wendarr_the_deckless": [
      {
        "text": "+1% Fruit Efficiency, +5% Movement Speed and +15% Spell Haste",
        "color": "#ffc854"
      },
      {
        "text": " for every empty slot in your card deck."
      }
    ],
    "wendarr_start_deck": [
